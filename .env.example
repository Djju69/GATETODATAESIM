# ==== GATETODATA eSIM — environment ====
# Скопируйте в .env и заполните. Никогда не коммитьте .env!

# --- База данных ---
DB_PATH=./data/gatetodata.db

# --- Сайт ---
BASE_URL=http://localhost:3000

# --- Безопасность ---
# Случайная строка 32+ символов для подписи cookie-сессий
SESSION_SECRET=change-me-to-random-32-chars-min
# Пароль администратора (или ADMIN_PASSWORD_HASH, см. scripts/hash-password.ts)
ADMIN_PASSWORD=change-me-strong-password

# --- TELMO eSIM ---
# Ключ из личного кабинета TELMO (sk_test_... / sk_live_...)
TELMO_API_KEY=
# Базовый URL API (проверьте актуальный в личном кабинете TELMO)
TELMO_API_BASE=https://api.telmoesim.com/v1
# Секрет webhook TELMO, если выдан
TELMO_WEBHOOK_SECRET=

# --- Telegram ---
# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=
# Имя бота без @ (для ссылок)
TELEGRAM_BOT_USERNAME=
# Секрет для проверки webhook Telegram
TELEGRAM_WEBHOOK_SECRET=
# Telegram ID владельца (для уведомлений админу)
ADMIN_TELEGRAM_ID=

# --- Оплата: USDT (TRC-20) ---
# Ваш кошелёк TRON (TRC-20) для приёма USDT
USDT_WALLET_ADDRESS=
# Опционально: ключ TronGrid для повышения лимитов
TRONGRID_API_KEY=
# Курс USD -> USDT обычно 1:1
USDT_RATE=1.0

# --- Оплата: Telegram Stars ---
# Включить оплату Stars в боте (1/0)
PAYMENTS_STARS_ENABLED=1
